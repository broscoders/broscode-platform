# ── Database ──────────────────────────────────────────────
# Vercel Postgres / Neon connection string (Vercel dashboard → Storage → your DB → .env.local tab)
DATABASE_URL="postgresql://user:password@host:5432/broscode?schema=public"

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="change_this_to_a_long_random_string"

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"

# ── Lead discovery (Google Places API) ───────────────────
# Free: Google Cloud gives a $200/month credit, which comfortably covers
# an MVP's usage. Enable "Places API (New)" in Google Cloud Console → get a key.
GOOGLE_PLACES_API_KEY=""

# ── Email (Resend) ────────────────────────────────────────
# Sign up free at resend.com → API Keys → create key.
RESEND_API_KEY=""

# ── Outbound email (nodemailer/SMTP — used by both one-click template
# sends and the AI Cold Email agent below). For Gmail: enable 2FA on the
# account, then create an "App Password" at myaccount.google.com/apppasswords
# and use that as SMTP_PASS (your normal Gmail password will NOT work).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── AI Cold Email follow-ups (daily cron on Vercel, see server/vercel.json) ─
# Any random string — also add the SAME value in Vercel's Environment
# Variables so Vercel's cron request is authenticated. Generate one with:
# openssl rand -hex 32
CRON_SECRET=""

# ── AI (Claude API — categorization, scoring, AI assistant) ─
ANTHROPIC_API_KEY=""

# ── AI (Groq — free/cheap, also powers the cold-calling agent's brain) ─
# Free key: console.groq.com
GROQ_API_KEY=""

# ── Cold Calling (Twilio) ─────────────────────────────────
# Sign up free at twilio.com -> Console gives you a trial number + credit.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Public URL Twilio can reach for call webhooks. Use `ngrok http 4000` locally
# (paste the https ngrok URL here), or your deployed API's Vercel URL in production.
SERVER_PUBLIC_URL=""
